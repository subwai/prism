{
  "name": "@prism/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#types/root": "./.react-router/types/src/+types/root.ts",
    "#types/routes/*": "./.react-router/types/src/routes/*.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "typegen": "react-router typegen",
    "check": "tsc",
    "lint": "oxlint",
    "test": "vitest run",
    "test:ui": "vitest watch --ui"
  },
  "dependencies": {
    "@prism/design-system": "workspace:*",
    "@prism/keybindings": "workspace:*",
    "@prism/shared": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "react-zoom-pan-pinch": "catalog:"
  },
  "devDependencies": {
    "@prism/typescript-configs": "workspace:*",
    "@react-router/dev": "catalog:",
    "@react-router/node": "catalog:",
    "@react-router/remix-routes-option-adapter": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/ui": "catalog:",
    "oxlint": "catalog:",
    "remix-flat-routes": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
