{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["$TURBO_ROOT$/out/renderer/**", ".react-router/types/**"],
    },
    "check": {
      "dependsOn": ["$TURBO_EXTENDS$", "typegen"],
    },
    "typegen": {
      "outputs": [".react-router/types/**"],
    },
    // The component tests run in Chromium, and play the end-to-end tests' video.
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "@prism/vitest-config#browsers"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/e2e/support/media/clip.webm"],
    },
    "test:ui": {
      "dependsOn": ["$TURBO_EXTENDS$", "@prism/vitest-config#browsers"],
    },
  },
}
