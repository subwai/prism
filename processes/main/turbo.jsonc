{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // The development icon is imported from the root's electron-builder resources.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/resources/icon.png"],
      "outputs": ["$TURBO_ROOT$/out/main/**"],
    },
  },
}
