{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // The development icons are imported from the root's electron-builder resources.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/resources/icon.png",
        "$TURBO_ROOT$/resources/icon-mac.png"
      ],
      "outputs": ["$TURBO_ROOT$/out/main/**"]
    }
  }
}
