{
  "name": "@prism/main",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "check": "tsc",
    "db:generate": "drizzle-kit generate",
    "lint": "oxlint",
    "build": "electron-vite build --ignoreConfigWarning",
    "test": "vitest run",
    "test:ui": "vitest watch --ui"
  },
  "dependencies": {
    "@prism/keybindings": "workspace:*",
    "@prism/media": "workspace:*",
    "@prism/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "electron-updater": "catalog:",
    "jsonc-parser": "catalog:",
    "p-limit": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@prism/electron-devtools-installer": "workspace:*",
    "@prism/typescript-configs": "workspace:*",
    "@prism/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/ui": "catalog:",
    "drizzle-kit": "catalog:",
    "electron": "catalog:",
    "electron-vite": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
