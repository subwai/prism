{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".oxlintrc.json", "packages/typescript-configs/*.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "@app/main#build": {
      "outputs": ["$TURBO_ROOT$/out/main/**"],
      "dependsOn": ["^build"]
    },
    "@app/preload#build": {
      "outputs": ["$TURBO_ROOT$/out/preload/**"],
      "dependsOn": ["^build"]
    },
    "@app/renderer#build": {
      "outputs": ["$TURBO_ROOT$/out/renderer/**", ".react-router/types/**"],
      "dependsOn": ["^build"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "@app/renderer#check": {
      "outputs": [".react-router/types/**"],
      "dependsOn": ["^check"]
    },
    "lint": {},
    "//#check:root": {},
    "//#lint:root": {},
    "//#dev:app": {
      "cache": false,
      "persistent": true
    }
  }
}
