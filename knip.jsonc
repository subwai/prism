{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // electron-builder ships the root package's dependencies with the app, and the bundled main
      // process loads these from there.
      "ignoreDependencies": [
        "@prism/trash",
        "@prism/windows-imaging",
        "exiftool-vendored",
        "sharp",
      ],
    },
    "e2e": {
      // Turborepo builds the app before the tests, and `global-setup.ts` resolves the test media
      // by a name it puts together.
      "ignoreDependencies": [
        "@prism/main",
        "@prism/preload",
        "@prism/renderer",
        "@prism/test-media",
      ],
    },
    "packages/catalog": {
      // `db:generate-ratings` passes this config to drizzle-kit by path.
      "entry": ["drizzle-ratings.config.ts"],
    },
    "packages/trash": {
      // `scripts/build.ts` runs its `napi` command through the shell.
      "ignoreDependencies": ["@napi-rs/cli"],
    },
    "packages/windows-imaging": {
      // `scripts/build.ts` runs its `napi` command through the shell.
      "ignoreDependencies": ["@napi-rs/cli"],
    },
    "processes/renderer": {
      // Knip's React Router plugin expects a server entry, which needs isbot, but the renderer is
      // an SPA with none.
      "ignoreDependencies": ["isbot"],
    },
  },
}
