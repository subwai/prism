{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Runs against the built app, so its workspace dependencies build first.
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["DISPLAY", "XAUTHORITY"],
    },
    "test:ui": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["DISPLAY", "XAUTHORITY"],
    },
  },
}
