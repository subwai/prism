// The default keyboard shortcuts. Your own go in keybindings.json, in the app's settings
// folder (File > Keyboard Shortcuts…), where they apply after these: for any key, the last
// rule that holds wins, and a command starting with "-" removes rules here.
//
// Written for macOS: elsewhere, ctrl stands in for cmd.
[
  { "key": "cmd+o", "command": "openFolder" },
  { "key": "cmd+f", "command": "find" },
  { "key": "cmd+r", "command": "refresh" },
  { "key": "cmd+shift+r", "command": "hardReload" },
  { "key": "cmd+[", "command": "back" },
  { "key": "cmd+]", "command": "forward" },
  { "key": "cmd+up", "command": "up" },
  { "key": "cmd+g", "command": "toggleView" },
  { "key": "cmd+shift+f", "command": "fullScreen" },

  // Bare keys get around: Space previews, Left and Right browse and Enter opens. Shift with
  // a key works the video or photo shown. Both stay out of text fields, where they type.
  { "key": "space", "command": "preview", "when": "!textInputFocus" },
  { "key": "left", "command": "previous", "when": "viewerFocus" },
  { "key": "right", "command": "next", "when": "viewerFocus" },
  { "key": "shift+space", "command": "playPause", "when": "videoShown && !textInputFocus" },
  { "key": "shift+left", "command": "seekBackward", "when": "videoShown && !textInputFocus" },
  { "key": "shift+right", "command": "seekForward", "when": "videoShown && !textInputFocus" },
  { "key": "shift+m", "command": "mute", "when": "videoShown && !textInputFocus" },
  { "key": "shift+f", "command": "actualSize", "when": "viewerShown && !textInputFocus" },
  { "key": "shift+s", "command": "slideshow", "when": "!textInputFocus" },
  { "key": "f2", "command": "rename", "when": "listFocus || treeFocus || viewerFocus" },
  // The menu key, where a keyboard has one, and Shift-F10, which works on a Mac too.
  {
    "key": "contextmenu",
    "command": "contextMenu",
    "when": "listFocus || treeFocus || viewerFocus",
  },
  { "key": "shift+f10", "command": "contextMenu", "when": "listFocus || treeFocus || viewerFocus" },
]
