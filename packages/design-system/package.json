  "devDependencies": {
    "@prism/typescript-configs": "workspace:*",
    "@prism/vitest-config": "workspace:*",
    "@types/react": "catalog:",
    "@vitest/ui": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "tailwindcss": "catalog:",
