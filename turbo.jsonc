{
  "$schema": "https://v2-11-9.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "lint": {
      // Every package lints with the shared root config.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    // Tests import their workspace dependencies' source, so a change there misses the cache.
    "test": {
      "dependsOn": ["transit"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test:ui": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    },
    // The root package's inputs leave out the other packages, which it formats too.
    "format:check": {
      "cache": false
    },
    "//#dev": {
      "cache": false,
      "persistent": true
    },
    "//#start": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "//#package": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "//#dist": {
      "dependsOn": ["^build"],
      // Signing credentials for electron-builder.
      "passThroughEnv": ["CSC_*", "WIN_CSC_*"],
      "cache": false
    },
    // Every package's tests as Vitest projects, in one run.
    "//#test:all": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["DISPLAY", "ELECTRON_HEADLESS", "XAUTHORITY"],
      // The root package's inputs leave out the packages whose tests it runs.
      "cache": false
    },
    "//#test:all:ui": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["DISPLAY", "ELECTRON_HEADLESS", "XAUTHORITY"],
      "cache": false,
      "persistent": true
    }
  },
  "agentGuidance": true
}
