{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  // Turns on the app's debug logs, such as `prism:*`, in every task that runs it.
  "globalEnv": ["DEBUG"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
    },
    "check": {
      "dependsOn": ["^check"],
    },
    "lint": {
      // Every package lints with the shared root config.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"],
    },
    // Tests import their workspace dependencies' source, so a change there misses the cache.
    "test": {
      "dependsOn": ["transit"],
    },
    "transit": {
      "dependsOn": ["^transit"],
    },
    "test:ui": {
      "cache": false,
      "persistent": true,
    },
    "format": {
      "cache": false,
    },
    // Writes the photo index's next migration from its schema, into the source.
    "db:generate": {
      "cache": false,
    },
    // Writes the ratings file's next migration from its schema, into the source.
    "db:generate-ratings": {
      "cache": false,
    },
    // The root package's inputs leave out the other packages, which it formats too.
    "format:check": {
      "cache": false,
    },
    // Knip reads every package from the root.
    "//#knip": {
      "cache": false,
    },
    "//#dev": {
      "cache": false,
      "persistent": true,
    },
    // The root depends on the processes' builds here rather than in its `package.json`: a
    // workspace dependency of the root marks every package affected when it changes.
    "//#start": {
      "dependsOn": ["^build", "@prism/main#build", "@prism/preload#build", "@prism/renderer#build"],
      "cache": false,
      "persistent": true,
    },
    "//#package": {
      "dependsOn": ["^build", "@prism/main#build", "@prism/preload#build", "@prism/renderer#build"],
      "cache": false,
    },
    "//#dist": {
      "dependsOn": ["^build", "@prism/main#build", "@prism/preload#build", "@prism/renderer#build"],
      // Signing credentials for electron-builder.
      "passThroughEnv": ["CSC_*", "WIN_CSC_*"],
      "cache": false,
    },
    // Adds the installers to the release's draft, as the Release workflow does.
    "//#dist:publish": {
      "dependsOn": ["^build", "@prism/main#build", "@prism/preload#build", "@prism/renderer#build"],
      // Signing credentials, and the token to upload to the release.
      "passThroughEnv": ["CSC_*", "WIN_CSC_*", "GH_TOKEN"],
      "cache": false,
    },
    // Renders the PNG icons from their vector layers.
    "//#icons": {
      "inputs": ["scripts/icons.ts", "packages/design-system/src/brand/**"],
      "outputs": ["resources/icon.png", "resources/icon-mac.png"],
    },
    // Every package's tests as Vitest projects, in one run, the component tests in Chromium.
    "//#test:all": {
      "dependsOn": [
        "^build",
        "@prism/main#build",
        "@prism/preload#build",
        "@prism/renderer#build",
        "@prism/vitest-config#browsers",
      ],
      "passThroughEnv": ["DISPLAY", "XAUTHORITY"],
      // The root package's inputs leave out the packages whose tests it runs.
      "cache": false,
    },
    "//#test:all:ui": {
      "dependsOn": [
        "^build",
        "@prism/main#build",
        "@prism/preload#build",
        "@prism/renderer#build",
        "@prism/vitest-config#browsers",
      ],
      "passThroughEnv": ["DISPLAY", "XAUTHORITY"],
      "cache": false,
      "persistent": true,
    },
  },
  // The Checks workflow runs only the tasks a pull request affects. These select a task by its
  // `inputs`, so a change to the root `.oxlintrc.json` reruns every lint, and compare against
  // `origin/main`, which is the only copy of `main` in the workflow's checkout.
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "githubActionsRemoteBaseRefFallback": true,
  },
  "agentGuidance": true,
}
