{
  "name": "electron-starter",
  "version": "0.4.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "start": "electron .",
    "package": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:publish": "electron-builder --publish onTagOrDraft",
    "icons": "node scripts/icons.ts",
    "check": "tsc",
    "lint": "oxlint scripts electron.vite.config.ts vitest.config.ts",
    "test:all": "vitest run",
    "test:all:ui": "vitest watch --ui",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "changeset": "changeset",
    "version:release": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile"
  },
  "dependencies": {
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@prism/main": "workspace:*",
    "@prism/preload": "workspace:*",
    "@prism/renderer": "workspace:*",
    "@prism/typescript-configs": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/ui": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.22.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
